{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pottery-stencil-maker",
  "compatibility_date": "2026-10-01",
  // The app runs entirely in the browser, so the Worker serves the Vite build as static assets.
  // The script in src/cloudflare.ts maps the /projects/ URL onto those files.
  "main": "src/cloudflare.ts",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  "routes": [{ "pattern": "aasimsani.net/projects/pottery-stencil-maker*", "zone_name": "aasimsani.net" }]
}
